ricingType":"external","hasExperienceReview":false,"brand":"코멧"},{"id":"coupang-8452579582-24456175948","title":"코멧 철재 이동식 2단 스탠드 행거, 화이트","imgUrl":"/home-living/coupang-8452579582-24456175948.webp","blogPath":"home-living/coupang-8452579582-24456175948","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"코멧"},{"id":"coupang-9515508546-28360463174","title":"투에스리빙 튼튼한 이동식 철제 수납 행거, 블랙A","imgUrl":"/home-living/coupang-9515508546-28360463174.webp","blogPath":"home-living/coupang-9515508546-28360463174","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"투에스리빙"},{"id":"coupang-6543052094-14575652830","title":"리빙해피 스탠드 공간행거 500, 화이트","imgUrl":"/home-living/coupang-6543052094-14575652830.webp","blogPath":"home-living/coupang-6543052094-14575652830","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"리빙해피"}],"comparisons":[{"id":"ptc-room-heater-size-control-buying-guide","category":"home-living","label":"PTC 온풍기","title":"PTC 온풍기 4종 비교: 탁상형·회전형·타워형 고르기","description":"온풍기는 놓을 자리와 조작 방식부터 정하면 후보를 줄이기 쉽습니다. 책상 주변에는 크기와 무게가 표시된 퓨어코치 CH1000W, 바람 방향을 바꾸려면 회전·송풍 기능이 안내된 홈플래닛 NDQ1302B를 대조해 보세요. 홈플래닛 DQ2133R은 리모컨이 포함된 타워형이고, 위닉스 FFC300-V0는 3000W 스탠드형으로 리모컨 미포함 표기를 확인해야 합니다. 이 가이드는 확인한 상품 정보의 차이를 정리했으며 소음과 난방 성능을 실측하지 않았습니다. 소비전력과 사용면적 표기만으로 전기요금이나 실제 실내온도를 단정하지 않습니다.","productIds":["coupang-6073583477-11224102499","coupang-2046727983-3479498345","coupang-6795755235-16023547089","coupang-6843093977-16277999894"],"blogPath":"home-living/ptc-room-heater-size-control-buying-guide"},{"id":"desk-foot-warmers-buying-guide","category":"home-living","label":"사무실 발난로","title":"사무실 발난로 4종 비교: 풋워머·발매트·파티션형","description":"책상 아래가 추울 때는 발을 넣을지, 발을 매트 위에 올릴지, 발 주변에 히터를 세울지부터 정해야 합니다. 러비쉬 BOOTS는 발을 넣는 풋워머, 한일전기 전기발방석은 44×44cm의 평평한 발매트형 선택지입니다. 에어보나와 듀플렉스는 접이식 파티션 형태라 설치 공간과 의자 이동 동선이 중요합니다. 확인한 판매 옵션의 발열 성능을 같은 조건에서 측정한 결과는 없습니다. 전원 방식, 소비전력, 사용 시간과 안전 이격 거리는 각 모델의 상세 정보와 설명서에서 대조하세요.","productIds":["coupang-8974619660-26269655896","coupang-46700604-165593051","coupang-6774858421-15916553673","coupang-6203450632-12323547369"],"blogPath":"home-living/desk-foot-warmers-buying-guide"},{"id":"wireless-mouse-use-case-buying-guide","category":"home-living","label":"무선 마우스 용도별 구매 가이드","title":"무선 마우스 비교: 블루투스·USB 수신기, 내 PC에는 무엇이 맞을까?","description":"노트북의 USB 포트를 남겨두려면 Bluetooth 연결부터, Bluetooth가 없는 데스크톱이라면 수신기 방식부터 살펴보세요. 로지텍 M240은 Bluetooth로 연결하고, G304는 전용 USB 수신기를 사용하는 제품입니다. 노트북과 태블릿을 번갈아 쓴다면 최대 3대 전환을 지원하는 Pebble M350S가 비교 대상이 됩니다. 아이리버 EQwear-EV3의 버티컬 형태는 연결 방식과 별개로 손 크기와 버튼 위치를 따져야 합니다. 네 제품을 같은 용도의 순위로 묶지 않고 연결, 기기 전환, 그립과 설치 제약으로 나눴습니다. 저소음 표기나 버티컬 형태만으로 사용 만족도와 손목 부담을 단정하지 않습니다.","productIds":["logitech-m240-silent-black","logitech-pebble-m350s-white","iriver-eqwear-ev3-black","logitech-g304-black"],"blogPath":"home-living/wireless-mouse-use-case-buying-guide"},{"id":"mechanical-keyboard-buying-guide","category":"home-living","label":"기계식 키보드 구매 가이드","title":"기계식 키보드 배열 비교: 풀배열·텐키리스·75%, 무엇을 포기할까?","description":"숫자 키패드를 매일 쓴다면 풀배열을 남기고, 마우스를 움직일 공간이 부족하다면 텐키리스나 75% 배열부터 비교하세요. AULA F108Pro는 숫자 키패드를 포함한 일반형, F87 Pro는 텐키리스, 큐센 Q75 PBT는 방향키와 주요 기능키를 남긴 75% 배열입니다. MCHOSE Ace68 V2는 유선 68키급 자석축 모델로, 작은 배열뿐 아니라 게임 입력 설정이 필요한 경우에 따로 비교할 제품입니다. 이 글은 배열·연결·정확한 스위치 옵션과 포기해야 할 기능을 나눠 살펴봅니다. 저소음 표기만으로 실제 타건음을 단정하거나 8K 표기를 곧바로 체감 성능 차이로 해석하지 않습니다.","productIds":["mechanical-keyboard-aula-f108pro","mechanical-keyboard-aula-f87pro","mechanical-keyboard-qsenn-q75-pbt","mechanical-keyboard-mchose-ace68-v2"],"blogPath":"home-living/mechanical-keyboard-buying-guide"},{"id":"led-table-mirror-fold-charging-buying-guide","category":"home-living","label":"LED 탁상거울","title":"LED 탁상거울 4종 비교: 회전·접이 구조와 충전 단자","description":"확대 표기와 회전 구조를 함께 보려면 무아스 360도 듀얼을, 접어서 옮기려면 슬림 폴더블 스퀘어를 비교할 수 있습니다. 집에 둘 원형 USB-C 제품으로는 무아스 퓨어가 후보이며, 패셔네이트 요요는 Micro 5pin 단자와 두 가지 색온도를 안내합니다. 같은 무선 LED 거울이라도 보관 형태와 충전 준비물이 다릅니다. 이 글은 정확한 판매 옵션과 상세 사양을 대조한 자료이며 밝기, 확대 효과, 배터리 지속시간을 직접 시험한 평가는 아닙니다.","productIds":["coupang-8279433972-23868734872","coupang-1546451967-2647665054","coupang-6138544978-11757234165","coupang-8285705448-23891994136"],"blogPath":"home-living/led-table-mirror-fold-charging-buying-guide"},{"id":"yogurt-fermentation-maker-buying-guide","category":"home-living","label":"요거트 발효기","title":"요거트 발효기 4종 비교: 무전기·한 통·8구·우유팩","description":"콘센트 없이 쓰려면 뜨거운 물로 보온하는 로이첸 요거트 데이를, 한 통에 만들려면 키친아트 KY-P3082를 비교할 수 있습니다. 처음부터 병에 나눠 만들고 싶다면 유리용기 8개를 제공하는 요거쉐프가 후보입니다. 보만 JM6523은 우유팩 사용법과 시간·온도 설정 버튼을 안내합니다. 전기 사용 여부만큼 세척할 용기 수와 냉장고에 둘 형태가 중요합니다. 이 글은 우유를 발효시키는 제조기 비교이며, 완성된 요거트에서 유청을 거르는 도구와는 용도가 다릅니다. 판매 안내를 기준으로 정리했고 발효 결과나 건강 효과를 직접 시험하지 않았습니다.","productIds":["coupang-3344472-10207249","coupang-8499436226-24602782029","coupang-4970810549-6599224740","coupang-9606210082-28677627036"],"blogPath":"home-living/yogurt-fermentation-maker-buying-guide"},{"id":"home-baking-oven-capacity-buying-guide","category":"home-living","label":"홈베이킹 오븐","title":"홈베이킹 오븐 4종 비교: 19~48L 용량·열선·구성품","description":"적은 분량으로 시작한다면 테팔 19L와 키친아트 20L부터 비교할 수 있습니다. 테팔은 최대 240°C와 120분 타이머를, 키친아트는 오븐팬·그릴 등 포함 도구를 확인할 수 있습니다. 더 큰 용량이 필요하면 상하 독립 열선을 안내하는 리빙웰 AF40040L와 리빙오븐PRO48L를 살펴보세요. 선택의 기준은 리터 수만이 아닙니다. 사용할 틀과 팬이 들어가는지, 위아래 열을 어떻게 조절하는지, 주방에 방열 공간이 남는지까지 맞아야 합니다. 판매 사양을 비교한 글이며 실제 베이킹 결과나 온도 편차를 시험하지는 않았습니다.","productIds":["coupang-27886117-107688935","coupang-4650284239-5797232547","coupang-6348886687-13350844454","coupang-9689437811-28978601377"],"blogPath":"home-living/home-baking-oven-capacity-buying-guide"},{"id":"stand-clothes-rack-space-buying-guide","category":"home-living","label":"스탠드 행거","title":"스탠드 행거 4종 비교: 설치 크기·1단과 2단·수납 선반","description":"행거를 놓을 자리가 작다면 코멧 홈 1단의 66cm 폭과 리빙해피 공간행거 500의 실제 폭 59.5cm부터 비교하세요. 코멧 철재 2단은 폭 120cm, 높이 200cm로 더 넓은 공간이 필요합니다. 옷 아래에 가방까지 정리하려면 투에스리빙의 바구니·측면 걸이 구성을 살펴볼 수 있지만, 상세 이미지의 제품명 차이 때문에 치수는 판매자 확인이 필요합니다. 전체 높이보다 중요한 것은 옷걸이 아래부터 바닥이나 선반까지 남는 길이입니다. 이번 비교는 판매 페이지와 상품 이미지를 기준으로 하며 흔들림이나 하중을 직접 시험한 결과는 아닙니다.","productIds":["coupang-7539323611-20994256921","coupang-8452579582-24456175948","coupang-9515508546-28360463174","coupang-6543052094-14575652830"],"blogPath":"home-living/stand-clothes-rack-space-buying-guide"}],"pageNumber":3,"totalPages":18,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}