,"category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"코멧"},{"id":"coupang-5206962617-7271652195","title":"예밀 페달 통돌이 회전 걸레 프리미엄형, 1세트","imgUrl":"/home-living/coupang-5206962617-7271652195.webp","blogPath":"home-living/coupang-5206962617-7271652195","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"예밀"},{"id":"coupang-9138237349-26897906724","title":"유즈베러띵 발로 꾹 원터치 밀대 걸레, 단품 1개","imgUrl":"/home-living/coupang-9138237349-26897906724.webp","blogPath":"home-living/coupang-9138237349-26897906724","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"유즈베러띵"},{"id":"coupang-6617697472-15032505327","title":"코멧 홈 패브릭 접이식 빨래바구니, 화이트","imgUrl":"/home-living/coupang-6617697472-15032505327.webp","blogPath":"home-living/coupang-6617697472-15032505327","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"코멧"},{"id":"coupang-2945641-13771120","title":"샤바스 스칸디나 트임형 세탁바구니, 브라운","imgUrl":"/home-living/coupang-2945641-13771120.webp","blogPath":"home-living/coupang-2945641-13771120","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"샤바스"},{"id":"coupang-7790368597-21075219628","title":"네이쳐리빙 모던 트롤리 스윙 3단 빨래바구니, 아이보리","imgUrl":"/home-living/coupang-7790368597-21075219628.webp","blogPath":"home-living/coupang-7790368597-21075219628","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"네이쳐리빙"},{"id":"coupang-8464997128-24491444059","title":"히키스 접이식 이동식 틈새 빨래통, IVORY","imgUrl":"/home-living/coupang-8464997128-24491444059.webp","blogPath":"home-living/coupang-8464997128-24491444059","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"히키스"}],"comparisons":[{"id":"bath-mat-material-care-buying-guide","category":"home-living","label":"욕실 발매트","title":"욕실 발매트 4종 비교: 메모리폼·규조토·빨아쓰는 타월형","description":"욕실 발매트는 소재 이름보다 세탁과 건조를 어떻게 할지 먼저 정하면 고르기 쉽습니다. 코멧 메모리폼은 폴리에스터 겉감에 폴리우레탄 충전재를 쓴 40 x 60cm 구성이고, 코멧 규조토는 60 x 39 x 0.9cm로 두께가 표시됩니다. 일상나눔은 챠콜 사각 40 x 60cm의 빨아쓰는 제품이며, 한샘 바스크는 60 x 40cm 면 타월형으로 세탁기 사용 가능 표시를 확인했습니다. 비슷한 면적이어도 소재와 관리 조건은 다릅니다. 실제 흡수 속도, 건조 시간, 밟았을 때의 느낌은 시험하지 않았으므로 순위를 매기지 않았습니다. 문 아래 간격과 매트 아래 바닥 상태도 함께 살펴보세요.","productIds":["coupang-7340785500-18866696461","coupang-189630131-541611107","coupang-6396133388-14594589167","coupang-8512239080-24640405551"],"blogPath":"home-living/bath-mat-material-care-buying-guide"},{"id":"cutting-board-material-size-buying-guide","category":"home-living","label":"재질별 도마","title":"도마 4종 비교: 느티나무·TPU·실리콘·스테인리스 양면형","description":"도마는 재질과 함께 조리대에서 쓸 면적, 씻고 말릴 자리를 봐야 합니다. 이번 4종은 느티나무와 실리콘이 각각 35 x 22cm, TPU가 39 x 26.3cm이며 스테인리스·실리콘 양면형은 36.5 x 24.5cm입니다. 나무 도마는 두께 16mm까지 확인했고, TPU와 실리콘은 거치대가 포함되지 않는 구성입니다. 넓은 도마를 원하면 TPU부터, 같은 크기에서 재질을 비교하려면 느티나무와 실리콘부터 살펴볼 수 있습니다. 항균 성능이나 칼집 저항, 열탕·식기세척기 사용 가능 여부는 재질명만으로 판단하지 않았습니다. 구매 전 각 제품의 관리 안내를 확인하세요.","productIds":["coupang-9470027168-28186013639","coupang-7991722426-28086284355","coupang-8354733524-24795461451","coupang-9344411328-27715303325"],"blogPath":"home-living/cutting-board-material-size-buying-guide"},{"id":"desk-power-strip-form-buying-guide","category":"home-living","label":"책상용 멀티탭","title":"책상용 멀티탭 4종 비교: 개별스위치·슬림·큐브·타워","description":"책상용 멀티탭은 연결할 플러그 수와 전원을 끄는 방식부터 고르면 범위가 좁아집니다. 홈플래닛은 2m 전선의 개별스위치 4구, 원스탑은 1m 전선의 슬림형 3구입니다. USB 케이블까지 한곳에 모으려면 라이프썸의 3구·USB 4포트 큐브형을, 더 많은 콘센트가 필요하면 지클릭커의 8구 타워형을 비교할 수 있습니다. 모양만 보고 틈새 설치나 어댑터 간섭 해소를 보장하지는 않았습니다. 전선 길이와 설치 자리를 먼저 재고, USB 충전 출력과 연결 기기의 합산 소비전력을 별도로 확인하세요.","productIds":["coupang-9039649267-26521847495","coupang-8826084661-29003790190","coupang-8695036264-27002687482","coupang-8817385635-25692059787"],"blogPath":"home-living/desk-power-strip-form-buying-guide"},{"id":"bedding-vacuum-bag-size-buying-guide","category":"home-living","label":"이불 압축팩","title":"이불 압축팩 4종 비교: 펌프·맨손형과 56~120cm 크기","description":"이불 압축팩은 봉투 크기와 공기를 빼는 방법을 함께 봐야 합니다. 코멧은 70 x 100 cm 압축팩 8개에 전용펌프가 포함되고, 조은리빙은 같은 표시 치수의 밸브형 5매입입니다. 청소기 없이 쓰는 방식을 원한다면 리브맘 56 x 80 cm 4개입, 더 넓은 봉투가 필요하다면 리벤스 120 x 100 cm 2매입을 비교할 수 있습니다. 대형·초대형 같은 이름은 브랜드마다 달라 실제 치수를 우선했습니다. 압축률과 밀봉 유지 기간은 확인되지 않아 순위를 매기지 않았으며, 넣을 침구의 압축 허용 조건과 도구 호환을 확인하는 것이 먼저입니다.","productIds":["coupang-8336066607-24070455644","coupang-8451050587-91786967","coupang-5620199346-9108286117","coupang-354165-9481168"],"blogPath":"home-living/bedding-vacuum-bag-size-buying-guide"},{"id":"heated-seat-pad-size-power-buying-guide","category":"home-living","label":"전기방석","title":"전기방석 4종 비교: 27cm 휴대형부터 130cm 소파형까지","description":"전기방석은 좌판을 얼마나 덮을지와 어떤 전원에 연결할지를 먼저 정해야 합니다. 아이리버 IHP-270U는 27 x 27 cm USB형이고, 한일상사 밤하늘고래 UH-100은 40 x 40 cm에 정격 5V·소비전력 5W로 표시된 제품입니다. 소파의 긴 좌판을 덮으려면 더안 DHB-2024의 45 x 90 cm, HanilMedical HL-101(20)의 50 x 130 cm를 대조해 보세요. 2인용·3인용이라는 이름보다 실제 치수가 더 분명한 기준입니다. 확인되지 않은 온도 단계나 자동 종료 시간은 비교 수치에 넣지 않았습니다. 설치할 가구의 사용 조건과 제품 설명서를 확인하고, 소비전력만으로 따뜻함이나 안전성을 판단하지 마세요.","productIds":["coupang-9160525641-26981918501","coupang-8401698390-24286650284","coupang-6043863475-11057365228","coupang-6155762022-11913938883"],"blogPath":"home-living/heated-seat-pad-size-power-buying-guide"},{"id":"travel-neck-pillow-air-memory-buying-guide","category":"home-living","label":"여행용 목베개","title":"여행용 목베개 4종 비교: 메모리폼·에어펌프·후드·양면형","description":"여행용 목베개는 충전 방식과 부가 구성부터 나눠 보세요. 랑고 멜로우는 메모리폼과 파우치를 묶은 세트이고, 트래블캣은 공기를 주입하는 에어펌프형입니다. 후드가 있는 구성을 원하면 슬립니스, 양면형을 찾는다면 지티스의 정확한 옵션을 비교할 수 있습니다. 다만 FREE나 남녀공용이라는 표기만으로 목둘레와 좌석에 맞는지 알 수는 없습니다. 이 글은 확인한 제품 구성과 옵션을 정리한 비교이며, 착용감과 수면 효과를 시험한 후기가 아닙니다. 무게와 수납 치수, 커버 세탁 범위가 중요한 여행이라면 주문 전에 판매 설명에서 해당 수치를 확인하세요.","productIds":["coupang-9244534005-27338950925","coupang-8181107911-23390140943","coupang-9221339859-27249463595","coupang-9132127024-26872361857"],"blogPath":"home-living/travel-neck-pillow-air-memory-buying-guide"},{"id":"manual-mop-spray-spin-buying-guide","category":"home-living","label":"밀대걸레","title":"밀대걸레 4종 비교: 청소포·스프레이·회전탈수·원터치","description":"밀대걸레는 바닥을 닦은 뒤 무엇을 교체하고 씻어야 하는지부터 비교해 보세요. 코멧 막대걸레 세트는 물걸레 청소포 30매 2팩을 포함하고, 코멧 스프레이 스퀴지는 분무 기능과 극세사 패드 6개를 갖춘 구성입니다. 예밀 페달 통돌이는 탈수통까지 둘 공간이 있을 때 살펴볼 후보입니다. 유즈베러띵 원터치형은 밀대 단품이므로 청소포를 따로 준비해야 합니다. 청소포 비용, 패드를 말릴 자리, 탈수통 보관 공간 가운데 무엇이 부담인지 정하면 선택이 좁아집니다. 실제 세척력이나 손목 부담을 시험한 비교는 아니며, 확인한 구성과 관리 조건을 기준으로 정리했습니다.","productIds":["coupang-5171607790","coupang-9034557628-26503181058","coupang-5206962617-7271652195","coupang-9138237349-26897906724"],"blogPath":"home-living/manual-mop-spray-spin-buying-guide"},{"id":"laundry-basket-folding-trolley-buying-guide","category":"home-living","label":"빨래바구니","title":"빨래바구니 4종 비교: 패브릭·트임형·3단·틈새형","description":"빨래바구니는 담는 양보다 놓을 자리와 옮기는 방법부터 정하면 고르기 쉽습니다. 코멧 패브릭 접이식은 바퀴 없이 쓰는 대형 바구니이고, 샤바스 스칸디나 트임형은 플라스틱 기본형입니다. 빨래를 나누어 담고 굴려 옮기려면 네이쳐리빙 모던 트롤리 스윙 3단, 틈새에 둘 이동형을 찾는다면 히키스 접이식 빨래통의 치수를 살펴보세요. 같은 접이식이라도 바퀴와 거치대 구성은 다릅니다. 표시 치수만으로 리터 용량이나 젖은 빨래 적재 한도를 추정하지 않고, 실제 설치할 공간과 관리 안내를 함께 확인하는 비교입니다.","productIds":["coupang-6617697472-15032505327","coupang-2945641-13771120","coupang-7790368597-21075219628","coupang-8464997128-24491444059"],"blogPath":"home-living/laundry-basket-folding-trolley-buying-guide"}],"pageNumber":1,"totalPages":15,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}