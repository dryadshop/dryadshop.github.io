blogPath":"home-living/window-robot-hutt-ddc56","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"HUTT"},{"id":"window-robot-ecovacs-wg841-01","title":"ECOVACS 윈봇 미니 창문 로봇청소기 WG841-01 혼합색상","imgUrl":"/home-living/window-robot-ecovacs-wg841-01.webp","blogPath":"home-living/window-robot-ecovacs-wg841-01","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"ECOVACS"},{"id":"window-robot-everybot-ws400","title":"에브리봇 엣지원도우2 창문 로봇청소기 WS400 화이트","imgUrl":"/home-living/window-robot-everybot-ws400.webp","blogPath":"home-living/window-robot-everybot-ws400","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"에브리봇"},{"id":"window-robot-powerguard-pwb-u570","title":"파워가드 윈클봇 울트라 창문 로봇청소기 PWB-U570 화이트","imgUrl":"/home-living/window-robot-powerguard-pwb-u570.webp","blogPath":"home-living/window-robot-powerguard-pwb-u570","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"파워가드"}],"comparisons":[{"id":"carbon-heating-mat-buying-guide","category":"home-living","label":"탄소매트 구매 가이드","title":"탄소매트 비교: 미니싱글·워셔블·분리난방 고르기","description":"탄소매트는 소재 이름보다 침대 크기, 세탁 방식, 조절 범위를 먼저 확인해야 해요. 미니싱글은 곰표한일 MSP-F75GY, Q 워셔블형은 듀플렉스 탄소열선 전기요예요. 110V·220V 여행용은 한일의료기 프리볼트 탄소매트, 퀸 분리난방은 쿠쿠 CHM-BC10Q를 비교해요. 전압·세탁·조절기 관리 조건을 함께 살펴봐요. 상품명의 인증·전자파 관련 표현만으로 안전성을 단정하지 않고 실제 치수와 허용 세탁법, 장시간 사용 주의사항을 확인하는 것이 중요해요.","productIds":["carbon-mat-gompyo-hanil-msp-f75gy","carbon-mat-duplex-q-ivory","carbon-mat-hanil-freevolt-travel","carbon-mat-cuckoo-chm-bc10q"],"blogPath":"home-living/carbon-heating-mat-buying-guide"},{"id":"food-dehydrator-buying-guide","category":"home-living","label":"식품건조기 구매 가이드","title":"식품건조기 비교: 5단·와이드·스테인리스 고르기","description":"식품건조기는 단수가 많을수록 좋은 것이 아니라 한 번에 말릴 양과 설치·세척 공간을 함께 봐야 해요. 디지털 5단은 한일전기 HFD-WN500, 6단 와이드형은 키친아트 KKW-KG7000이에요. 그물망 8개 구성은 리큅 LD-918BH, 스테인리스 10단 대용량은 리큅 LOD-S1000SS를 비교해요. 트레이 구성과 관리 부담을 기준으로 살펴봐요. 많은 단을 채울수록 위치별 건조 속도가 달라질 수 있으므로 트레이 교대와 장시간 가동할 통풍 공간도 함께 고려해요.","productIds":["food-dehydrator-hanil-hfd-wn500","food-dehydrator-kitchenart-kkw-kg7000","food-dehydrator-lequip-ld-918bh","food-dehydrator-lequip-lod-s1000ss"],"blogPath":"home-living/food-dehydrator-buying-guide"},{"id":"power-bank-buying-guide","category":"home-living","label":"보조배터리 구매 가이드","title":"보조배터리 비교: 도킹·맥세이프·100W 고르기","description":"보조배터리는 용량보다 먼저 충전할 기기와 필요한 단자·출력을 정하면 선택이 쉬워져요. 케이블 없는 C타입 도킹형은 스피디 SPE-B2PA5GPQCP, 10000mAh 맥세이프형은 YINTO W18이에요. 8핀·C타입 듀얼케이블은 베이스어스 Qpow2, 노트북용 100W·20000mAh는 베이스어스 블레이드 2세대를 비교해요. 실제 호환 출력과 휴대성을 함께 살펴봐요.","productIds":["power-bank-speedy-spe-b2pa5gpqcp","power-bank-yinto-w18","power-bank-baseus-qpow2-10000","power-bank-baseus-blade2-20000"],"blogPath":"home-living/power-bank-buying-guide"},{"id":"portable-monitor-buying-guide","category":"home-living","label":"휴대용 모니터 구매 가이드","title":"휴대용 모니터 비교: 해상도·터치·120Hz 고르기","description":"휴대용 모니터는 화면 크기만 아니라 노트북의 출력 포트와 원하는 해상도·주사율을 함께 맞춰야 해요. 40cm WQXGA 작업 화면은 LG전자 16MR70, 35.56cm 2.1K 균형형은 빅트랙 140PM02Q예요. 4K UHD 터치형은 빅트랙 133PM01UT, 15.6인치 120Hz IPS는 제우스랩 P15A120hz를 비교해요. 네 제품을 화면 사양과 연결 호환성 기준으로 살펴봐요.","productIds":["portable-monitor-lg-16mr70","portable-monitor-bigtrack-140pm02q","portable-monitor-bigtrack-133pm01ut","portable-monitor-zeuslap-p15a120hz"],"blogPath":"home-living/portable-monitor-buying-guide"},{"id":"home-ice-maker-buying-guide","category":"home-living","label":"가정용 제빙기 구매 가이드","title":"가정용 제빙기 비교: 크기·제빙량·세척 고르기","description":"가정용 제빙기는 빠르다는 표현보다 본체 치수, 일 제빙량과 물통·바스켓 용량을 구분해서 봐야 해요. 브랜드 포터블형은 쿠쿠 CIM-AS09M10S, 미니 급속냉각형은 포첸 PCI-M237·PCF-M237이에요. 슬림형과 SUS304·12kg 표기를 원하면 대웅 DW-ICE12K8W, 기본 탁상형 대안은 트루리빙 TL-ICE12KG를 비교해요. 네 제품을 크기, 생산량 표기, 모델 일치와 세척 기준으로 살펴봐요.","productIds":["ice-maker-cuckoo-cim-as09m10s","ice-maker-pochen-pci-m237","ice-maker-daewoong-dw-ice12k8w","ice-maker-trueliving-tl-ice12kg"],"blogPath":"home-living/home-ice-maker-buying-guide"},{"id":"cordless-bathroom-cleaner-buying-guide","category":"home-living","label":"무선 욕실 청소기 구매 가이드","title":"무선 욕실 청소기 비교: 사용시간·브러시·미니형 고르기","description":"무선 욕실 청소기는 브러시 수보다 실제 청소 구역과 충전 주기를 먼저 정하면 선택이 쉬워져요. 최대 100분 표기와 1.1kg은 88그로스 BP202501WH, 4WAY와 60분 표기는 투랩 TL19예요. 4종 브러시 구성을 원하면 에페이오스 EPSC115, 세면대와 좁은 구역용 미니형은 보아르 VCL-031WH를 비교해요. 네 제품을 사용시간, 헤드 구성, 크기와 물기 관리 기준으로 살펴봐요.","productIds":["bathroom-cleaner-88growth-bp202501wh","bathroom-cleaner-toolab-tl19","bathroom-cleaner-epeios-epsc115","bathroom-cleaner-voar-vcl-031wh"],"blogPath":"home-living/cordless-bathroom-cleaner-buying-guide"},{"id":"mattress-topper-buying-guide","category":"home-living","label":"매트리스 토퍼 구매 가이드","title":"매트리스 토퍼 비교: 메모리폼·라텍스·통세탁형 고르기","description":"토퍼는 푹신하다는 표현보다 소재, 두께와 세탁 방법을 먼저 나누면 선택이 쉬워져요. 기본 메모리폼은 지누스, 양면 3중 레이어 6cm는 엠마예요. 얇은 천연라텍스 2.5cm 킹 옵션은 라폼, S 사이즈 통세탁 침구형은 소하임을 비교할 수 있어요. 네 제품을 소재와 높이, 정확 옵션, 관리 부담 기준으로 살펴봐요. 허리 통증 치료 효과는 보장하지 않으므로 수면 자세와 기존 매트리스 상태도 함께 확인하세요.","productIds":["mattress-topper-zinus-basic","mattress-topper-emma-6cm","mattress-topper-lafoam-king-25mm","mattress-topper-sohaim-s-charcoal"],"blogPath":"home-living/mattress-topper-buying-guide"},{"id":"window-robot-cleaner-buying-guide","category":"home-living","label":"창문 로봇청소기 구매 가이드","title":"창문 로봇청소기 비교: 분사·크기·안전장치 고르기","description":"창문 로봇청소기는 흡착 성능 문구보다 우리 집 유리와 프레임에 쓸 수 있는지, 안전줄을 어디에 고정할지를 먼저 봐야 해요. 자동 분사와 리필걸레 구성은 HUTT DDC56, 미니형은 ECOVACS WG841-01이에요. 국내 브랜드 모델을 비교하면 에브리봇 WS400, 다른 구성과 가격대는 파워가드 PWB-U570을 살펴볼 수 있어요. 네 제품을 분사, 크기, 소모품과 안전 기준으로 비교해요.","productIds":["window-robot-hutt-ddc56","window-robot-ecovacs-wg841-01","window-robot-everybot-ws400","window-robot-powerguard-pwb-u570"],"blogPath":"home-living/window-robot-cleaner-buying-guide"}],"pageNumber":4,"totalPages":9,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}