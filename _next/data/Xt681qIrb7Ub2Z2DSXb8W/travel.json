ping-wagon-comet-folding-cart","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"코멧"},{"id":"camping-wagon-aoran-ao004","title":"아오란 광폭타이어 전지형 캠핑웨건 150L AO004 갈색","imgUrl":"/travel/camping-wagon-aoran-ao004.webp","blogPath":"travel/camping-wagon-aoran-ao004","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"아오란"},{"id":"camping-wagon-mocalili-table","title":"MoCaLiLi 접이식 캠핑웨건 테이블보드 세트 블랙","imgUrl":"/travel/camping-wagon-mocalili-table.webp","blogPath":"travel/camping-wagon-mocalili-table","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"MoCaLiLi"},{"id":"camping-wagon-andersen-v3-ultra","title":"안델센 V3 울트라 뒷문개방형 캠핑웨건 블랙","imgUrl":"/travel/camping-wagon-andersen-v3-ultra.webp","blogPath":"travel/camping-wagon-andersen-v3-ultra","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"안델센"},{"id":"sono-belle-vivaldi-park","title":"[본사직영] 소노벨 비발디파크","imgUrl":"/travel/sono-belle-vivaldi-park.webp","blogPath":"travel/sono-belle-vivaldi-park","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"dynamic","hasExperienceReview":false,"brand":"소노호텔앤리조트"},{"id":"hanwha-resort-seorak-sorano","title":"한화리조트 설악 쏘라노 워터피아·조식뷔페 패키지","imgUrl":"/travel/hanwha-resort-seorak-sorano.webp","blogPath":"travel/hanwha-resort-seorak-sorano","category":"travel","categoryName":"여행·숙박","status":"active","pricingType":"dynamic","hasExperienceReview":false,"brand":"한화호텔앤드리조트"}],"comparisons":[{"id":"cooler-bag-mini-7l-26l-buying-guide","category":"travel","label":"보냉가방","title":"보냉가방 4종 비교: 미니 도시락형부터 7L·26L까지","description":"보냉가방은 미니·중형이라는 이름보다 도시락통의 바닥 크기와 음료를 세웠을 때의 높이를 먼저 대조하는 편이 좋습니다. 퍼니메이드 데이 미니와 브라운베어 중형은 표시 치수가 가까운 후보이고, 써모스 REW-007K와 펠코스는 각각 7L·26L 용량을 안내합니다. 혼자 먹을 도시락인지 여러 사람의 피크닉 짐인지에 따라 필요한 크기가 달라집니다. 이 글은 정확한 판매 옵션과 확인된 치수를 기준으로 수납과 휴대 방식을 비교했습니다. 보냉 지속시간을 측정한 후기는 아니며, 외형 치수와 용량만으로 보냉 성능이나 식품 보관시간을 보장하지 않습니다.","productIds":["coupang-99300300-303916093","coupang-5448569241-8308160673","coupang-7896769032-21632452390","coupang-9507917062-28331371530"],"blogPath":"travel/cooler-bag-mini-7l-26l-buying-guide"},{"id":"camping-mat-foam-self-inflating-buying-guide","category":"travel","label":"캠핑 매트","title":"캠핑 매트 4종 비교: 발포·돗자리형과 싱글·더블 자충형","description":"캠핑 매트는 바닥을 넓게 덮을 것인지, 개인별 취침 공간을 만들 것인지부터 나누면 비교하기 쉽습니다. 코멧 1인용 발포매트는 185×57cm, 코멧 2단 엠보싱은 202×140cm에 보관가방이 포함된 돗자리형입니다. 디센느 자충매트는 두께 5cm가 같은 싱글과 더블 옵션을 골랐으며 표시 가로길이가 각각 65cm와 130cm입니다. 크기와 설치 방식은 선택 기준이 되지만 두께만으로 보온 성능이나 취침감을 판단하지는 않습니다. 텐트 바닥 치수, 수납 부피와 밸브 사용법까지 확인한 뒤 사용 목적에 맞는 형태를 고르세요.","productIds":["coupang-8643722543-25087049047","coupang-5197274270-7234685239","coupang-7405857350-25120229984","coupang-7405857350-25120229986"],"blogPath":"travel/camping-mat-foam-self-inflating-buying-guide"},{"id":"travel-compression-pouch-set-buying-guide","category":"travel","label":"여행용 압축 파우치","title":"여행용 압축 파우치 4종 비교: 4·5·6·7종 세트 구성","description":"여행용 압축 파우치는 세트 개수보다 실제로 나눠 담을 짐과 개별 파우치의 크기를 먼저 살펴보는 편이 좋습니다. 니드잇은 S·M·L·XL 4종, 어반트립은 여기에 다용도 파우치가 포함된 5종으로 안내됩니다. LXU는 이중지퍼 6종, 라멜리는 7종 혼합세트입니다. 같은 베이지 계열이어도 구성과 옵션명은 다르므로 구매할 세트를 구분해야 합니다. 이 가이드는 확인된 구성과 잠금 방식, 표시 소재를 중심으로 비교합니다. 압축 후 부피나 캐리어별 수납량은 시험하지 않았으며, 개별 치수와 세탁 조건은 구매 전 확인사항으로 남겼습니다.","productIds":["coupang-9387839799-27875825736","coupang-9397763305-27912274790","coupang-9370358806-27810620214","coupang-9148856386-26936740733"],"blogPath":"travel/travel-compression-pouch-set-buying-guide"},{"id":"pop-up-tent-capacity-size-buying-guide","category":"travel","label":"원터치텐트 인원·설치 크기 구매 가이드","title":"원터치텐트 4종 비교: 3~4인·4인·5인·6인용 고르기","description":"원터치텐트의 표기 인원은 장비까지 넣는 실제 취침 인원과 다를 수 있어요. 코멧 아웃도어는 145×245×110cm 3~4인용, 로티캠프 컴포트는 4인용, 패스트캠프 메가5는 5인용 팝업형입니다. 스위스마운틴 헥사돔은 6인용으로 표시돼요. 사용할 매트와 짐을 바닥 치수에 놓아 보고 설치 면적과 차량 수납 공간까지 비교하세요. 비나 바람이 예상되면 내수압, 봉제선 처리와 고정 로프 포함 여부도 상세 정보에서 확인해야 합니다.","productIds":["comet-outdoor-pop-up-tent-3-4p-green","loticamp-comfort-pop-up-tent-4p-tan","fastcamp-mega5-pop-up-tent-5p","swissmountain-hexadome-pop-up-tent-6p"],"blogPath":"travel/pop-up-tent-capacity-size-buying-guide"},{"id":"camping-sleeping-bag-shape-season-buying-guide","category":"travel","label":"캠핑 침낭 형태·계절 구매 가이드","title":"캠핑 침낭 4종 비교: 더블·여름용·사각형·겨울 머미형","description":"캠핑 침낭은 상품명보다 예상 최저기온, 사용 인원과 수납 공간을 먼저 봐야 해요. 빈슨메시프 히프노스 더블은 넉넉한 겨울용 구성, 돌핀은 여름용, 네이처하이크 LD150은 1.3kg 사각형, 히프노스 머미는 2100g 겨울용입니다. 형태와 계절 표기를 비교하되 실제 온도 범위는 주문 전 다시 확인해야 해요. 차량 캠핑이라도 수납 부피를 확인하고, 겨울용 표기 제품은 제조사가 제시한 온도 범위와 매트 단열을 함께 살펴보세요.","productIds":["vinson-hypnos-double","dolphin-summer-microfiber","naturehike-nh-ld150","vinson-hypnos-mummy-2100"],"blogPath":"travel/camping-sleeping-bag-shape-season-buying-guide"},{"id":"camping-table-buying-guide","category":"travel","label":"캠핑 테이블 구매 가이드","title":"캠핑 테이블 4종 비교: 컴팩트·하드탑·폴딩·높이조절","description":"캠핑 테이블은 인원수와 의자 높이, 차량 적재 공간을 함께 봐야 해요. 코베아 컴팩트 테이블은 작은 설치 면적, 헬리녹스 테이블원 하드탑은 경량 구조와 단단한 상판을 비교하는 제품입니다. 코멧 2폴딩 테이블은 가방 세트로 표시된 입문형, 캠핑힐스 접이식 테이블은 높이 조절이 필요한 환경에 맞아요. 펼침·수납 치수와 무게, 허용 하중, 상판 재질과 가방 포함 여부를 구매 전에 확인해 보세요. 화기 사용은 상판 재질과 제조사 안전 지침을 따라야 합니다.","productIds":["kovea-compact-camping-table","helinox-table-one-hard-top","comet-two-folding-camping-table","campinghills-adjustable-folding-table"],"blogPath":"travel/camping-table-buying-guide"},{"id":"camping-wagon-buying-guide","category":"travel","label":"캠핑웨건 구매 가이드","title":"캠핑웨건 비교: 기본·광폭·테이블·뒷문형 고르기","description":"캠핑웨건은 최대 하중 숫자보다 실제 짐의 길이, 바닥 상태와 보관 공간부터 맞춰야 해요. 기본 폴딩 운반형은 코멧 아웃도어 카트, 150L와 광폭타이어를 원하면 아오란 AO004를 살펴볼 수 있어요. 운반 뒤 간이 테이블로 쓰려면 MoCaLiLi 테이블보드 세트, 긴 장비 적재와 분리형 바퀴를 중시하면 안델센 V3 울트라를 나란히 살펴봅니다. 표기 하중과 기본 구성도 주문 전에 다시 점검해 봅니다.","productIds":["camping-wagon-comet-folding-cart","camping-wagon-aoran-ao004","camping-wagon-mocalili-table","camping-wagon-andersen-v3-ultra"],"blogPath":"travel/camping-wagon-buying-guide"}],"pageNumber":1,"totalPages":1,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}