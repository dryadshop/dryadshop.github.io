road-w15-wet-dry-mop.webp","blogPath":"home-living/redroad-w15-wet-dry-mop","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"Redroad"},{"id":"bosch-go-3-plus-driver","title":"보쉬 GO 3 PLUS 3.6V 전동 드라이버","imgUrl":"/home-living/bosch-go-3-plus-driver.webp","blogPath":"home-living/bosch-go-3-plus-driver","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"Bosch"},{"id":"worx-wx240-3-driver","title":"WORX WX240.3 4V 무선 스크류 드라이버","imgUrl":"/home-living/worx-wx240-3-driver.webp","blogPath":"home-living/worx-wx240-3-driver","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"WORX"},{"id":"xiaomi-mjddlsd001qw-driver","title":"샤오미 MJDDLSD001QW 3.6V 전동 드라이버","imgUrl":"/home-living/xiaomi-mjddlsd001qw-driver.webp","blogPath":"home-living/xiaomi-mjddlsd001qw-driver","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"Xiaomi"},{"id":"keyang-dm12l-30i-drill","title":"계양 DM12L-30I 12V MAX 해머드릴 세트","imgUrl":"/home-living/keyang-dm12l-30i-drill.webp","blogPath":"home-living/keyang-dm12l-30i-drill","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"Keyang"},{"id":"tapo-c201-home-camera","title":"Tapo C201 원격회전 홈카메라","imgUrl":"/home-living/tapo-c201-home-camera.webp","blogPath":"home-living/tapo-c201-home-camera","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"TP-Link Tapo"},{"id":"tapo-c260-home-camera","title":"Tapo C260 4K AI 회전형 홈카메라","imgUrl":"/home-living/tapo-c260-home-camera.webp","blogPath":"home-living/tapo-c260-home-camera","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"TP-Link Tapo"},{"id":"tapo-c425-kit-camera","title":"Tapo C425 KIT 배터리 카메라 태양광 패널 세트","imgUrl":"/home-living/tapo-c425-kit-camera.webp","blogPath":"home-living/tapo-c425-kit-camera","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"TP-Link Tapo"},{"id":"tapo-c320ws-outdoor-camera","title":"Tapo C320WS 실외용 Wi-Fi CCTV","imgUrl":"/home-living/tapo-c320ws-outdoor-camera.webp","blogPath":"home-living/tapo-c320ws-outdoor-camera","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"TP-Link Tapo"}],"comparisons":[{"id":"wireless-earbuds-form-factor-buying-guide","category":"home-living","label":"무선 이어폰 형태별 구매 가이드","title":"무선 이어폰 4종 비교: 커널형·오픈형·골전도 고르기","description":"무선 이어폰은 음질 수치보다 귀를 막는 방식과 사용할 장소를 먼저 정하는 편이 쉬워요. QCY T13 APP은 기본 커널형, HT08은 노이즈 캔슬링 표시가 있는 커널형, CT06은 밀폐감이 적은 오픈형으로 비교할 수 있습니다. 샥즈 OpenRun Air 2 S610은 귀를 막지 않는 골전도 방식이에요. 이어팁 적합성, 주변 소리 인지, 소리 누출, 스마트폰 앱 호환성과 충전 동선을 함께 확인하세요.","productIds":["qcy-t13-app-earbuds","qcy-ht08-melobuds-pro-plus","qcy-ct06-open-earbuds","shokz-openrun-air-2-s610"],"blogPath":"home-living/wireless-earbuds-form-factor-buying-guide"},{"id":"coffee-grinder-buying-guide","category":"home-living","label":"커피 그라인더 구매 가이드","title":"커피 그라인더 4종 비교: 수동·무선·원터치·80단계 고르기","description":"커피 그라인더는 휴대성과 속도, 분쇄도 반복성 중 무엇을 우선할지 정하면 쉬워요. 타임모어 C2S는 수동 핸드밀, Voltmate는 30단계 무선 전동, 홈플래닛 CG9701-CB는 분리 세척이 쉬운 원터치형, 홀츠클로츠 E80은 80단계와 100ml를 표시한 탁상형입니다. 단계 수만 믿기보다 버 또는 칼날 방식, 1회 원두량, 잔량과 정전기, 청소 범위를 함께 확인하세요.","productIds":["timemore-chestnut-c2s-grinder","voltmate-wireless-30step-grinder","homeplanet-cg9701-cb-grinder","holzklotz-e80-coffee-grinder"],"blogPath":"home-living/coffee-grinder-buying-guide"},{"id":"clothing-care-system-buying-guide","category":"home-living","label":"의류관리기 구매 가이드","title":"의류관리기 4종 비교: 3벌·5벌·옷장형·미니형 고르기","description":"의류관리기는 설치 공간과 한 번에 관리할 옷 수부터 정해야 해요. LG SC3GTE52는 상의 3벌 방문설치형, 삼성 DF18CB8600ER은 상의 3~5벌과 하의 1벌, 클레비온은 비용을 낮춘 옷장형, 라비킷 LV24-SK01은 소량용 미니형입니다. 살균·주름·탈취 같은 상품명 표현만으로 고르지 말고 실제 코스, 소재 제한, 물통과 필터 관리, 설치 및 A/S 조건을 확인하세요.","productIds":["lg-styler-sc3gte52","samsung-airdresser-df18cb8600er","clevion-clothing-care-cabinet","lavikit-stylekit-lv24-sk01"],"blogPath":"home-living/clothing-care-system-buying-guide"},{"id":"portable-label-printer-buying-guide","category":"home-living","label":"휴대용 라벨프린터 구매 가이드","title":"휴대용 라벨프린터 4종 비교: 미니·300dpi·테이프·키보드형 고르기","description":"휴대용 라벨프린터는 작은 네임스티커용 감열 롤, 넓고 선명한 300dpi, 내구성 있는 카세트 테이프, 휴대폰 없는 키보드형으로 나눠 보면 쉬워요. 님봇 D110은 미니 입문형, B1 Pro는 300dpi와 넓은 라벨, 브라더 PT-P300BT는 블루투스 테이프형, 엡손 LW-K200BL은 본체 키보드 독립형입니다. 본체 가격만 보지 말고 지원 라벨 폭과 소모품 단가, 앱 호환성, 전원 구성까지 함께 확인하세요.","productIds":["niimbot-d110-label-printer","niimbot-b1-pro-label-printer","brother-pt-p300bt-label-printer","epson-lw-k200bl-label-printer"],"blogPath":"home-living/portable-label-printer-buying-guide"},{"id":"steam-cleaner-buying-guide","category":"home-living","label":"스팀청소기 구매 가이드","title":"스팀청소기 4종 비교: 2in1·멀티헤드·슬림·스크럽 고르기","description":"스팀청소기는 바닥만 닦을지, 주방과 욕실의 틈새까지 부속품을 바꿔 청소할지부터 나눠야 해요. 한경희 HSM-1010TI는 370ml 물통의 2in1, 홈앤아트 AMS-200은 연장툴과 여러 헤드, 비쎌 BA-BS2233S는 스팀+물걸레 슬림형으로 비교할 수 있습니다. 샤크 S8201KR은 별도 틈새 헤드보다 바닥 중심 구성을 살펴보는 선택지예요. 고온 스팀을 쓰기 전에 바닥재와 실리콘, 코팅 표면의 허용 조건을 확인하고 물통은 충분히 식힌 뒤 열어야 합니다.","productIds":["hahn-kyunghee-hsm-1010ti-steam-cleaner","homeandart-ams-200-steam-cleaner","bissell-ba-bs2233s-steam-cleaner","shark-s8201kr-steam-scrub"],"blogPath":"home-living/steam-cleaner-buying-guide"},{"id":"cordless-mop-cleaner-buying-guide","category":"home-living","label":"무선 물걸레청소기 구매 가이드","title":"무선 물걸레청소기 4종 비교: 회전식·흡입·자동세척 고르기","description":"바닥의 먼지를 따로 치운 뒤 가볍게 닦을지, 흡입과 물걸레를 한 번에 끝낼지에 따라 필요한 무선 물걸레청소기가 달라져요. 이노웰 HC-2000R은 단순한 무선 물걸레 작업, 신일 SDC-WC3008은 회전식 패드와 여분 걸레 구성을 중심으로 비교할 수 있습니다. 프리티케어 WD01과 Redroad W15는 흡입과 물 공급, 자동세척 범위를 함께 살펴야 해요. 본체 가격만 보지 말고 충전 동선, 오수통과 롤러를 씻고 말릴 공간, 교체 패드와 필터 비용까지 확인하세요.","productIds":["innowell-hc-2000r-cordless-mop","shinil-sdc-wc3008-cordless-mop","prettycare-wd01-cordless-mop","redroad-w15-wet-dry-mop"],"blogPath":"home-living/cordless-mop-cleaner-buying-guide"},{"id":"electric-screwdriver-buying-guide","category":"home-living","label":"가정용 전동 드라이버 구매 가이드","title":"가정용 전동 드라이버 4종 비교: 3.6V·4V·12V 해머드릴","description":"가정용 전동 드라이버는 나사 체결만 할지 구멍 가공과 해머 기능까지 필요할지 먼저 구분해야 해요. 보쉬 GO 3 PLUS와 샤오미 MJDDLSD001QW는 3.6V 휴대형, WORX WX240.3은 4V 무선 스크류 드라이버입니다. 계양 DM12L-30I는 12V MAX 해머드릴 세트로 작업 범위와 크기가 달라요. 전압만으로 성능을 단정하지 말고 토크 단계, 비트와 배터리 구성, 척 규격과 작업 소재를 확인하세요. 보호구를 착용하고 제조사가 허용한 용도로 사용해야 합니다.","productIds":["bosch-go-3-plus-driver","worx-wx240-3-driver","xiaomi-mjddlsd001qw-driver","keyang-dm12l-30i-drill"],"blogPath":"home-living/electric-screwdriver-buying-guide"},{"id":"home-cctv-buying-guide","category":"home-living","label":"홈 CCTV·홈캠 구매 가이드","title":"홈 CCTV·홈캠 4종 비교: 실내 회전형·배터리·실외 유선","description":"홈캠은 설치 장소와 전원, 저장 방식을 먼저 정해야 해요. Tapo C201은 200만 화소 실내 회전형, C260은 4K 800만 화소 회전형으로 표시됩니다. C425 KIT는 배터리 카메라와 태양광 패널 세트, C320WS는 상시 전원을 전제로 보는 실외용 Wi-Fi 카메라예요. 해상도만 비교하지 말고 전원 배선, 방수 등급, 야간 촬영과 저장 매체, 앱과 구독 조건을 확인하세요. 촬영 범위는 사유 공간으로 제한하고 가족과 방문자의 프라이버시도 고려해야 합니다.","productIds":["tapo-c201-home-camera","tapo-c260-home-camera","tapo-c425-kit-camera","tapo-c320ws-outdoor-camera"],"blogPath":"home-living/home-cctv-buying-guide"}],"pageNumber":3,"totalPages":10,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}