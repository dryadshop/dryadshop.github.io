ype":"external","hasExperienceReview":false,"brand":"쿠쿠"},{"id":"ice-maker-pochen-pci-m237","title":"포첸 급속냉각 가정용 미니 제빙기 PCI-M237 PCF-M237","imgUrl":"/home-living/ice-maker-pochen-pci-m237.webp","blogPath":"home-living/ice-maker-pochen-pci-m237","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"포첸"},{"id":"ice-maker-daewoong-dw-ice12k8w","title":"대웅 슬림형 급속 제빙기 DW-ICE12K8W SUS304 12kg","imgUrl":"/home-living/ice-maker-daewoong-dw-ice12k8w.webp","blogPath":"home-living/ice-maker-daewoong-dw-ice12k8w","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"대웅"},{"id":"ice-maker-trueliving-tl-ice12kg","title":"트루리빙 쏘 쿨 아이스메이커 TL-ICE12KG","imgUrl":"/home-living/ice-maker-trueliving-tl-ice12kg.webp","blogPath":"home-living/ice-maker-trueliving-tl-ice12kg","category":"home-living","categoryName":"홈리빙","status":"active","pricingType":"external","hasExperienceReview":false,"brand":"트루리빙"}],"comparisons":[{"id":"motion-desk-buying-guide","category":"home-living","label":"전동 모션데스크 구매 가이드","title":"전동 모션데스크 4종 비교: 싱글·듀얼모터와 3단 프레임","description":"전동 모션데스크는 상판 크기와 최저·최고 높이, 모터와 프레임 구조를 함께 봐야 해요. FlexiSpot EF1은 기본형, EJ2는 듀얼모터, E5는 3단 듀얼모터 구성이 표시돼요. 롱코 싱글 슬림은 제한된 공간에 맞춘 비교 대상입니다. 키에 맞는 높이 범위와 모니터·본체를 포함한 하중, 상판 포함 여부를 먼저 확인하세요. 배송과 조립 방식, 보증 기간의 적용 범위도 판매 옵션별로 달라질 수 있습니다.","productIds":["flexispot-ef1-motion-desk","flexispot-ej2-motion-desk","longke-single-slim-motion-desk","flexispot-e5-motion-desk"],"blogPath":"home-living/motion-desk-buying-guide"},{"id":"home-printer-buying-guide","category":"home-living","label":"가정용 프린터 구매 가이드","title":"가정용 프린터 4종 비교: 잉크젯·레이저·무한잉크 고르기","description":"가정용 프린터는 컬러 출력, 복사와 스캔, 출력량을 먼저 구분하면 선택이 쉬워져요. 캐논 TS3490은 컬러 잉크젯 복합기, 삼성 SL-M2030은 흑백 레이저 단일 기능, SL-C513W는 컬러 레이저 프린터예요. 엡손 L3256은 잉크 탱크를 보충하는 무한잉크 복합기입니다. 문서 종류와 월간 출력량, 소모품 보관과 교체 방식, 무선 연결 필요 여부를 함께 비교하세요. 실제 잉크·토너 포함 구성과 지원 기능은 구매 시점의 선택 옵션에서 최종 확인해야 합니다.","productIds":["canon-ts3490-printer","samsung-sl-m2030-printer","samsung-sl-c513w-printer","epson-l3256-printer"],"blogPath":"home-living/home-printer-buying-guide"},{"id":"sandwich-maker-buying-guide","category":"home-living","label":"샌드위치 메이커 구매 가이드","title":"샌드위치 메이커 비교: 미니·전자레인지·3-in-1 고르기","description":"샌드위치 메이커는 전기식인지 전자레인지용인지, 플레이트 용도를 어디까지 원하는지 먼저 정하면 쉬워져요. 작은 전기식은 보본 VB-SM301P, 전자레인지용은 키텐실 3분 미니 제품이에요. 와플 겸용은 단미 DA-SAN01, 와플·샌드위치·붕어빵 3-in-1 분리형은 대우 DEW-D220을 비교해요. 조리량과 세척·수납 부담을 함께 살펴봐요. 여러 플레이트가 있어도 자주 쓰지 않으면 수납 부담이 커지므로 실제 포함 구성과 분리 세척 가능 여부를 구매 전에 확인해요.","productIds":["sandwich-maker-vobon-vb-sm301p","sandwich-maker-kittensil-microwave-pink","sandwich-maker-danmi-da-san01","sandwich-maker-daewoo-dew-d220"],"blogPath":"home-living/sandwich-maker-buying-guide"},{"id":"carbon-heating-mat-buying-guide","category":"home-living","label":"탄소매트 구매 가이드","title":"탄소매트 비교: 미니싱글·워셔블·분리난방 고르기","description":"탄소매트는 소재 이름보다 침대 크기, 세탁 방식, 조절 범위를 먼저 확인해야 해요. 미니싱글은 곰표한일 MSP-F75GY, Q 워셔블형은 듀플렉스 탄소열선 전기요예요. 110V·220V 여행용은 한일의료기 프리볼트 탄소매트, 퀸 분리난방은 쿠쿠 CHM-BC10Q를 비교해요. 전압·세탁·조절기 관리 조건을 함께 살펴봐요. 상품명의 인증·전자파 관련 표현만으로 안전성을 단정하지 않고 실제 치수와 허용 세탁법, 장시간 사용 주의사항을 확인하는 것이 중요해요.","productIds":["carbon-mat-gompyo-hanil-msp-f75gy","carbon-mat-duplex-q-ivory","carbon-mat-hanil-freevolt-travel","carbon-mat-cuckoo-chm-bc10q"],"blogPath":"home-living/carbon-heating-mat-buying-guide"},{"id":"food-dehydrator-buying-guide","category":"home-living","label":"식품건조기 구매 가이드","title":"식품건조기 비교: 5단·와이드·스테인리스 고르기","description":"식품건조기는 단수가 많을수록 좋은 것이 아니라 한 번에 말릴 양과 설치·세척 공간을 함께 봐야 해요. 디지털 5단은 한일전기 HFD-WN500, 6단 와이드형은 키친아트 KKW-KG7000이에요. 그물망 8개 구성은 리큅 LD-918BH, 스테인리스 10단 대용량은 리큅 LOD-S1000SS를 비교해요. 트레이 구성과 관리 부담을 기준으로 살펴봐요. 많은 단을 채울수록 위치별 건조 속도가 달라질 수 있으므로 트레이 교대와 장시간 가동할 통풍 공간도 함께 고려해요.","productIds":["food-dehydrator-hanil-hfd-wn500","food-dehydrator-kitchenart-kkw-kg7000","food-dehydrator-lequip-ld-918bh","food-dehydrator-lequip-lod-s1000ss"],"blogPath":"home-living/food-dehydrator-buying-guide"},{"id":"power-bank-buying-guide","category":"home-living","label":"보조배터리 구매 가이드","title":"보조배터리 비교: 도킹·맥세이프·100W 고르기","description":"보조배터리는 용량보다 먼저 충전할 기기와 필요한 단자·출력을 정하면 선택이 쉬워져요. 케이블 없는 C타입 도킹형은 스피디 SPE-B2PA5GPQCP, 10000mAh 맥세이프형은 YINTO W18이에요. 8핀·C타입 듀얼케이블은 베이스어스 Qpow2, 노트북용 100W·20000mAh는 베이스어스 블레이드 2세대를 비교해요. 실제 호환 출력과 휴대성을 함께 살펴봐요.","productIds":["power-bank-speedy-spe-b2pa5gpqcp","power-bank-yinto-w18","power-bank-baseus-qpow2-10000","power-bank-baseus-blade2-20000"],"blogPath":"home-living/power-bank-buying-guide"},{"id":"portable-monitor-buying-guide","category":"home-living","label":"휴대용 모니터 구매 가이드","title":"휴대용 모니터 비교: 해상도·터치·120Hz 고르기","description":"휴대용 모니터는 화면 크기만 아니라 노트북의 출력 포트와 원하는 해상도·주사율을 함께 맞춰야 해요. 40cm WQXGA 작업 화면은 LG전자 16MR70, 35.56cm 2.1K 균형형은 빅트랙 140PM02Q예요. 4K UHD 터치형은 빅트랙 133PM01UT, 15.6인치 120Hz IPS는 제우스랩 P15A120hz를 비교해요. 네 제품을 화면 사양과 연결 호환성 기준으로 살펴봐요.","productIds":["portable-monitor-lg-16mr70","portable-monitor-bigtrack-140pm02q","portable-monitor-bigtrack-133pm01ut","portable-monitor-zeuslap-p15a120hz"],"blogPath":"home-living/portable-monitor-buying-guide"},{"id":"home-ice-maker-buying-guide","category":"home-living","label":"가정용 제빙기 구매 가이드","title":"가정용 제빙기 비교: 크기·제빙량·세척 고르기","description":"가정용 제빙기는 빠르다는 표현보다 본체 치수, 일 제빙량과 물통·바스켓 용량을 구분해서 봐야 해요. 브랜드 포터블형은 쿠쿠 CIM-AS09M10S, 미니 급속냉각형은 포첸 PCI-M237·PCF-M237이에요. 슬림형과 SUS304·12kg 표기를 원하면 대웅 DW-ICE12K8W, 기본 탁상형 대안은 트루리빙 TL-ICE12KG를 비교해요. 네 제품을 크기, 생산량 표기, 모델 일치와 세척 기준으로 살펴봐요.","productIds":["ice-maker-cuckoo-cim-as09m10s","ice-maker-pochen-pci-m237","ice-maker-daewoong-dw-ice12k8w","ice-maker-trueliving-tl-ice12kg"],"blogPath":"home-living/home-ice-maker-buying-guide"}],"pageNumber":2,"totalPages":8,"navigation":[{"name":"home-fitness","convertName":"홈트레이닝"},{"name":"travel","convertName":"여행·숙박"},{"name":"home-living","convertName":"홈리빙"},{"name":"mac","convertName":"Mac 선택 가이드"}]},"__N_SSG":true}